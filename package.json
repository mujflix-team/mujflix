{
  "name": "mujflix",
  "version": "3.21.4",
  "private": true,
  "type": "module",
  "description": "MůjFlix — osobní tracker filmů a seriálů (statická PWA)",
  "scripts": {
    "lint": "eslint -c scripts/eslint.config.js .",
    "serve": "python3 -m http.server 8080",
    "test": "node tests/smoke.mjs && node tests/flows.mjs && node tests/discover.mjs && node tests/worker.mjs",
    "pretest": "node scripts/version.mjs",
    "bump": "node scripts/version.mjs",
    "check-sources": "node scripts/check-sources.mjs",
    "css-vars": "node scripts/css-vars.mjs --only-dup"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "playwright": "^1.48.0"
  }
}
